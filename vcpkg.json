{
  "name": "pid-gui",
  "version-string": "0.1.0",
  "dependencies": [],
  "features": {
    "serialport": {
      "description": "Install Qt Serial Port for device communication.",
      "dependencies": [
        "qtserialport"
      ]
    },
    "gstreamer": {
      "description": "Install GStreamer for UDP/RTP H.264 video reception and rendering.",
      "dependencies": [
        "pkgconf",
        {
          "name": "qtmultimedia",
          "default-features": false,
          "features": [
            "widgets"
          ]
        },
        {
          "name": "gstreamer",
          "features": [
            "plugins-good",
            "plugins-bad",
            "libav"
          ]
        }
      ]
    }
  }
}
